{
  "name": "@ai-content-os/api-contracts",
  "version": "0.1.0",
  "description": "Shared API response types, pagination contracts, and DTO contracts for AI Content OS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node init && tsc",
    "dev": "node init && tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ai-content-os/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.0",
    "rimraf": "^5.0.0"
  }
}
