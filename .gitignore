*.db
*.db-journal

# ── Docker local data ────────────────────────────────────────
infrastructure/docker/**/data/
postgres_data/
redis_data/

# ── Uploads / local media ────────────────────────────────────
uploads/
tmp/

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
