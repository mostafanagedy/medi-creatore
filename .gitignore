# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ── Environment & secrets (NEVER commit) ─────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

