# ============================================================
# AI CONTENT OS — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit real secrets to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL="postgresql://ai_content_os:ai_content_os_password@localhost:5432/ai_content_os?schema=public"

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Or use full URL:
# REDIS_URL=redis://:password@localhost:6379/0

# ── Security ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=your-cookie-secret-minimum-16-chars
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-encryption-key-for-oauth-token-storage-change-me

# ── Object Storage (S3-compatible) ───────────────────────────
# For AWS S3:
S3_REGION=us-east-1
S3_BUCKET=ai-content-os-media
S3_ACCESS_KEY=your-aws-access-key-id
S3_SECRET_KEY=your-aws-secret-access-key
S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com
S3_FORCE_PATH_STYLE=false

# For MinIO (local development):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=ai-content-os-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000/ai-content-os-media
# S3_FORCE_PATH_STYLE=true

# ── AI Providers ──────────────────────────────────────────────
# Codecraft API
CODECRAFT_API_KEY=cc_your_codecraft_api_key

# OpenAI (text, image, voice, transcription, embedding)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Claude (text)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google AI (text, image)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ElevenLabs (voice)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Runway ML (video generation)
RUNWAYML_API_KEY=your-runwayml-api-key

# HeyGen (avatar video)
HEYGEN_API_KEY=your-heygen-api-key

# Stability AI (image)
STABILITY_API_KEY=your-stability-ai-api-key

# ── OAuth — Google ────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OAuth — Meta (Facebook/Instagram) ────────────────────────
# Create at: https://developers.facebook.com/apps/
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret
META_APP_ID=your-meta-app-id

# ── OAuth — TikTok ────────────────────────────────────────────
# Create at: https://developers.tiktok.com/
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ── YouTube Data API ──────────────────────────────────────────
# Uses Google OAuth credentials above
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# ── Telegram Bot ──────────────────────────────────────────────
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── WhatsApp Business ─────────────────────────────────────────
# Setup at: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Stripe ────────────────────────────────────────────────────
# Get at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
EMAIL_FROM=noreply@ai-content-os.com
EMAIL_FROM_NAME="AI Content OS"

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=20

# ── Upload Limits ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_SIZE_MB=2000
