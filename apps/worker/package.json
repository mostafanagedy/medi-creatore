{
  "name": "@ai-content-os/worker",
  "version": "0.1.0",
  "private": true,
  "description": "AI Content OS — NestJS background job consumers",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@ai-content-os/database": "workspace:*",
    "@ai-content-os/queues": "workspace:*",
    "@ai-content-os/security": "workspace:*",
    "@ai-content-os/types": "workspace:*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@prisma/client": "^5.21.0",
    "bullmq": "^5.12.12",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@ai-content-os/tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "prisma": "^5.21.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "testEnvironment": "node"
  }
}
